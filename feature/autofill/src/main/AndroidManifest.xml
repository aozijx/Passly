<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name="com.aozijx.passly.feature.autofill.legacy.service.LegacyAutofillService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <service
            android:name="com.aozijx.passly.feature.autofill.accessibility.ManualAccessibilityFillService"
            android:exported="true"
            android:label="@string/accessibility_fill_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_fill_service_config" />
        </service>

        <!-- API 34+ CredentialProviderService, enabled by API-qualified feature resources. -->
        <service
            android:name="com.aozijx.passly.feature.autofill.credential.service.ModernCredentialService"
            android:enabled="@bool/credential_provider_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_service_config" />
        </service>
    </application>
</manifest>
