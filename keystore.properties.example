# Copy this file to keystore.properties (gitignored) for local release signing.
# You can also set equivalent env vars:
# SIGNING_STORE_FILE, SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS, SIGNING_KEY_PASSWORD

signing.store.file=C:/path/to/release.keystore
signing.store.password=your_store_password
signing.key.alias=your_key_alias
signing.key.password=your_key_password