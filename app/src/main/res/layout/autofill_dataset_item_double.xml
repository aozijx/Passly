<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/autofill_remote_item_min_height"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/autofill_remote_item_horizontal_padding"
    android:paddingEnd="@dimen/autofill_remote_item_horizontal_padding"
    android:paddingTop="@dimen/autofill_remote_item_double_vertical_padding"
    android:paddingBottom="@dimen/autofill_remote_item_double_vertical_padding">

    <TextView
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/autofill_remote_item_title_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/autofill_remote_item_text_spacing"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/autofill_remote_item_subtitle_text_size" />
</LinearLayout>
